# SHFSL 2.0 — environment configuration template.
# Copy to .env for local runs. NEVER commit a real .env file.

# --- Mode ---
# true  = safe isolated sandbox demo (required for any public deployment)
# false = production mode, watches SHFSL_MONITOR_ROOT for real
SHFSL_DEMO_MODE=true
SHFSL_DEBUG=false

# --- Production-only: real directory to monitor (ignored in demo mode) ---
SHFSL_MONITOR_ROOT=
SHFSL_DECOY_FILES=
SHFSL_SENSITIVE_FILES=

# --- Snapshots ---
SHFSL_SNAPSHOT_DIR=snapshot_storage
SHFSL_MAX_SNAPSHOTS_PER_FILE=10
SHFSL_SNAPSHOT_RETENTION_DAYS=30
SHFSL_MAX_SNAPSHOT_STORAGE_MB=200

# --- Logging ---
SHFSL_MAX_LOG_LINES=500
SHFSL_LOG_LEVEL=INFO

# --- Ransomware sweep detection ---
SHFSL_RAPID_DELETE_THRESHOLD=5
SHFSL_RAPID_DELETE_WINDOW_SECONDS=10

# --- Email alerting (production only; leave blank in demo mode) ---
SHFSL_SENDER_EMAIL=
SHFSL_RECEIVER_EMAIL=
SHFSL_SENDER_PASSWORD=
SHFSL_SMTP_SERVER=smtp.gmail.com
SHFSL_SMTP_PORT=587

# --- Web server (Render sets PORT automatically) ---
PORT=8501
